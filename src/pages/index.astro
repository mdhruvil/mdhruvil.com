---
import ProjectList from "../components/project-list.astro";
import SocialLinks from "../components/social-links.astro";
import WorkList from "../components/work-list.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout>
  <Fragment slot="intro">
    <p class="mt-7 text-[15px]/[1.75] text-pretty text-foreground max-sm:mt-6">
      {site.bio}
    </p>
    <SocialLinks />
  </Fragment>
  <WorkList />
  <ProjectList />
</BaseLayout>
