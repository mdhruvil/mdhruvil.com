---
import ProjectList from "../components/project-list.astro";
import SocialLinks from "../components/social-links.astro";
import WorkList from "../components/work-list.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout>
  <Fragment slot="intro">
    <p
      class="mt-16 text-[14px]/[1.75] text-pretty text-foreground max-sm:mt-14"
    >
      {site.bio.map((part) =>
        typeof part === "string" ? (
          part
        ) : (
          <a
            class="underline decoration-subtle underline-offset-4 transition-colors duration-150 hover:text-accent hover:decoration-accent"
            href={part.href}
            target="_blank"
            rel="noopener"
            >{part.label}</a
          >
        ),
      )}
    </p>
    <SocialLinks />
  </Fragment>
  <WorkList />
  <ProjectList />
</BaseLayout>
