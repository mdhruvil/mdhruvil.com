---
import SectionTitle from "../components/section-title.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/base-layout.astro";

const links = [
  { label: "/", href: "/" },
  { label: "/blog", href: "/blog" },
  { label: "/resume", href: "/resume.pdf" },
];
---

<BaseLayout title={`404 — ${site.name}`} description="Page not found.">
  <section class="reveal-1" aria-labelledby="not-found-title">
    <SectionTitle id="not-found-title" as="h1">404</SectionTitle>
    <p class="text-foreground">nothing lives at this path.</p>
    <ul class="mt-5">
      {links.map((link) => <li class="grid grid-cols-[auto_1fr] gap-x-2.5">
        <span class="text-subtle" aria-hidden="true"> - </span>
        <a
          class="hit w-fit text-body transition-colors duration-150 hover:text-accent"
          href={link.href}
        >
          {link.label}
        </a>
      </li>)}
    </ul>
  </section>
</BaseLayout>
