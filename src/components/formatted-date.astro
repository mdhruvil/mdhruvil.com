---
type Props = {
  date: Date;
  class?: string;
};

const { date, class: className } = Astro.props;
---

<time datetime={date.toISOString()} class={className}>
  {date
    .toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
    .toLowerCase()}
</time>
