---
import { site } from "../data/site";
import { getBuildInfo } from "../lib/build-info";

const build = getBuildInfo();
const commit = build
  ? { label: build.shortSha, href: build.url, title: build.message }
  : { label: "local", href: `${site.repo}/commits`, title: undefined };

const separator =
  "before:whitespace-pre before:text-subtle before:content-['__·__']";
// The footer is whitespace-sensitive, so its markup stays on purpose on one
// line between tags.
---

<!-- prettier-ignore -->
<footer
  class="reveal-3 mt-auto leading-[1.75] whitespace-nowrap text-muted [&_[data-pending]]:animate-pending motion-reduce:[&_[data-pending]]:animate-none [&_[data-pending]]:text-subtle"
  aria-live="polite"
><span>served from <b class="font-normal text-accent" data-colo data-pending>···</b> in <span data-rtt data-pending>··</span>ms<span
  class={separator}
  data-cache-wrap
>cache <b class="font-normal text-success" data-cache data-pending>···</b></span></span><span
  class:list={[separator, "max-sm:block max-sm:[--hit-y:13px] max-sm:before:content-none"]}
><a
  class="hit text-body transition-colors duration-150 hover:text-accent"
  href={commit.href}
  title={commit.title}
>{commit.label}</a> · updated <time
  datetime={build?.date.toISOString()}
  title={build?.date.toUTCString()}
  data-updated
  data-pending
>···</time></span></footer>

<script>
  import { getColoCity } from "../lib/colo-cities";
  import { formatRelativeTime } from "../lib/relative-time";
  import { readEdgeTiming } from "../lib/server-timing";

  function reveal(element: HTMLElement, text: string, title?: string) {
    element.textContent = text;
    if (title) element.title = title;
    element.removeAttribute("data-pending");
    element.classList.add("animate-resolve");
  }

  const query = (name: string) =>
    document.querySelector<HTMLElement>(`footer [data-${name}]`);

  function renderEdge() {
    const colo = query("colo");
    const rtt = query("rtt");
    const cache = query("cache");
    const cacheWrap = query("cache-wrap");
    if (!colo || !rtt || !cache || !cacheWrap) return;

    const timing = readEdgeTiming();
    if (timing.colo) {
      reveal(colo, timing.colo, getColoCity(timing.colo));
    } else {
      reveal(colo, "local");
    }
    if (timing.rttMs) {
      reveal(rtt, String(Math.max(1, Math.round(timing.rttMs))));
    } else {
      reveal(rtt, "–");
    }
    if (timing.cache) {
      reveal(cache, timing.cache.toUpperCase());
    } else {
      cacheWrap.hidden = true;
    }
  }

  function renderUpdated() {
    const updated = query("updated");
    const datetime = updated?.getAttribute("datetime");
    if (!updated) return;
    if (!datetime) {
      reveal(updated, "–");
      return;
    }
    const date = new Date(datetime);
    reveal(updated, formatRelativeTime(date));
    setInterval(() => (updated.textContent = formatRelativeTime(date)), 60_000);
  }

  renderEdge();
  renderUpdated();
</script>
