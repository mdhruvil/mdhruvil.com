---
type Props = {
  id: string;
  as?: "h1" | "h2";
};

const { id, as: Heading = "h2" } = Astro.props;
// The accent dash hangs in the left margin, and sits inline below sm.
---

<Heading
  id={id}
  class="relative mb-8 flex h-5 items-center text-[14px] font-bold text-foreground before:absolute before:top-[9.25px] before:-left-13 before:h-[1.5px] before:w-10 before:origin-right before:animate-draw before:bg-accent before:[animation-delay:calc(var(--reveal-delay,0ms)+180ms)] max-sm:gap-2.5 max-sm:before:static max-sm:before:flex-none"
>
  <slot />
</Heading>
