{
  "name": "mdhruvil-com",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "cf deploy",
    "deploy:preview": "cf previews deploy",
    "deploy:dry-run": "cf deploy --dry-run",
    "cf:version": "cf --version",
    "lint": "vp lint",
    "test": "vp test run",
    "format": "vp fmt && prettier --write \"src/**/*.astro\"",
    "format:check": "vp fmt --check && prettier --check \"src/**/*.astro\"",
    "check": "cf workers types && astro sync && vp check && prettier --check \"src/**/*.astro\" && astro check",
    "check:astro": "astro check",
    "cf-typegen": "cf workers types",
    "dev:resume": "mkdir -p .resume && typst watch resume.typ .resume/resume.pdf",
    "build:resume": "mkdir -p .resume && typst compile resume.typ .resume/resume.pdf"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^15.0.0-beta.3",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "remark-toc": "^9.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "cf": "^1.0.0-beta.20",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite-plus": "^1.3.0"
  }
}
